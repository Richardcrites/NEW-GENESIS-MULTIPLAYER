<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pulsar.ViewModels"
             mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="620"
             x:Class="Pulsar.Views.UpdateView"
             x:DataType="vm:UpdateViewModel">

    <ScrollViewer Padding="32,28">
        <StackPanel Spacing="0" MaxWidth="640" HorizontalAlignment="Left">

            <TextBlock Classes="PageTitle" Text="Updates" />
            <TextBlock Classes="PageSubtitle"
                       Text="Update the mod and read the latest patch notes, pulled straight from GitHub." />

            <Border Classes="Card" Margin="0,0,0,16">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding InstalledVersions}" Opacity="0.85" />
                    <TextBlock Text="{Binding LatestVersion}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Check now"
                                Command="{Binding CheckNowCommand}"
                                IsEnabled="{Binding !IsBusy}" />
                        <Button Content="Update mod"
                                Command="{Binding UpdateModCommand}"
                                IsEnabled="{Binding CanUpdateMod}" />
                        <Button Content="Open release page"
                                Command="{Binding OpenReleasePageCommand}" />
                    </StackPanel>
                    <TextBlock Text="Updating the mod copies the new files into Starfield. Close the game first."
                               FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Classes="Card" Margin="0,0,0,16">
                <StackPanel Spacing="8">
                    <TextBlock Classes="SectionHeader" Text="Source repositories" />
                    <TextBlock Text="Releases are published to these GitHub repos. They are private for now."
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="56,*,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tool"
                                   VerticalAlignment="Center" Opacity="0.75" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ToolRepoLabel}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Row="0" Grid.Column="2" Content="Open"
                                Command="{Binding OpenUrlCommand}" CommandParameter="{Binding ToolRepoUrl}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Mod"
                                   VerticalAlignment="Center" Opacity="0.75" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ModRepoLabel}"
                                   VerticalAlignment="Center" Margin="0,8,12,0" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Row="1" Grid.Column="2" Content="Open" Margin="0,8,0,0"
                                Command="{Binding OpenUrlCommand}" CommandParameter="{Binding ModRepoUrl}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="Card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="SectionHeader" Text="Patch notes" />
                    <TextBox Height="280"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontSize="13"
                             Text="{Binding PatchNotes}"
                             VerticalContentAlignment="Top" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
