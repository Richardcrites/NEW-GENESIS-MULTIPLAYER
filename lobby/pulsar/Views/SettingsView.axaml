<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pulsar.ViewModels"
             mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="620"
             x:Class="Pulsar.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer Padding="32,28">
        <StackPanel Spacing="0" MaxWidth="620" HorizontalAlignment="Left">

            <TextBlock Classes="PageTitle" Text="Settings" />
            <TextBlock Classes="PageSubtitle"
                       Text="Choose where your character lives and tweak advanced connection options." />

            <!-- Database -->
            <Border Classes="Card" Margin="0,0,0,16">
                <StackPanel Spacing="12">
                    <TextBlock Classes="SectionHeader" Text="Database" />

                    <RadioButton GroupName="db" Content="Online (official)"
                                 IsChecked="{Binding IsOnline}" />
                    <StackPanel Margin="28,0,0,0" Spacing="4" IsEnabled="{Binding IsOnline}">
                        <TextBlock Classes="FieldLabel" Text="Official server URI" />
                        <TextBox Text="{Binding OfficialStdbUri}" Watermark="wss://… (leave empty for the official server)" />
                    </StackPanel>

                    <RadioButton GroupName="db" Content="Local (offline / LAN)"
                                 IsChecked="{Binding IsLocal}" />
                    <StackPanel Margin="28,0,0,0" Spacing="4" IsEnabled="{Binding IsLocal}">
                        <TextBlock Classes="FieldLabel" Text="Local server URI" />
                        <TextBox Text="{Binding LocalStdbUri}" Watermark="ws://127.0.0.1:3000" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Advanced -->
            <Border Classes="Card" Margin="0,0,0,16">
                <StackPanel Spacing="10">
                    <TextBlock Classes="SectionHeader" Text="Advanced" />
                    <ToggleSwitch Content="Show advanced connection options"
                                  IsChecked="{Binding Advanced}" />
                    <StackPanel Spacing="4" IsVisible="{Binding Advanced}">
                        <TextBlock Classes="FieldLabel" Text="Relay override (host:port)" />
                        <TextBox Text="{Binding RelayOverride}" Watermark="leave empty to auto-derive from server" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <Border Classes="Card" Margin="0,0,0,16">
                <StackPanel Spacing="4">
                    <TextBlock Classes="SectionHeader" Text="Updates" />
                    <TextBlock Classes="FieldLabel" Text="Tool repository (owner/name)" />
                    <TextBox Text="{Binding ToolRepo}" Watermark="org/pulsar-tool" />
                    <TextBlock Classes="FieldLabel" Text="Mod repository (owner/name)" Margin="0,8,0,0" />
                    <TextBox Text="{Binding ModRepo}" Watermark="org/pulsar-mod" />
                </StackPanel>
            </Border>

            <!-- Character backup (export / import) -->
            <Border Classes="Card" Margin="0,0,0,16">
                <StackPanel Spacing="10">
                    <TextBlock Classes="SectionHeader" Text="Character backup" />
                    <TextBlock Classes="FieldLabel"
                               Text="Your character is auto-backed-up locally on every save. Export a copy to a file, or import one to restore it (e.g. after moving PCs or a database reset)." />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Export character..." Command="{Binding ExportCharacterCommand}" />
                        <Button Content="Import character..." Command="{Binding ImportCharacterCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding BackupStatus}" FontSize="12" Opacity="0.75"
                               IsVisible="{Binding BackupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <!-- Local stack (one-click self-host) -->
            <Border Classes="Card" Margin="0,0,0,16">
                <StackPanel Spacing="10">
                    <TextBlock Classes="SectionHeader" Text="Local stack (host on this PC / LAN)" />
                    <TextBlock Classes="FieldLabel"
                               Text="When the Database is set to Local, starting the daemon also launches SpacetimeDB + a local relay automatically." />
                    <TextBlock Classes="FieldLabel" Text="spacetime.exe path" />
                    <TextBox Text="{Binding SpacetimeExePath}"
                             Watermark="%LOCALAPPDATA%\SpacetimeDB\spacetime.exe" />
                </StackPanel>
            </Border>

            <!-- Danger zone: character wipe -->
            <Border Classes="Card" BorderBrush="#7A2A2A" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Classes="SectionHeader" Text="Danger zone" Foreground="#E0A33A" />
                    <TextBlock Classes="FieldLabel"
                               Text="Wipe your co-op character: deletes your saved progression (the database profile AND the local backup). This cannot be undone. The next time you load a solo save, your character is rebuilt fresh from that save. Only your own character is affected. Requires the tool to be connected." />
                    <CheckBox Content="Yes, permanently delete my co-op character"
                              IsChecked="{Binding WipeConfirm}" />
                    <Button Content="Wipe character"
                            HorizontalAlignment="Left"
                            Background="#7A1F1F" Foreground="White"
                            IsEnabled="{Binding WipeConfirm}"
                            Command="{Binding WipeCharacterCommand}" />
                    <TextBlock Text="{Binding WipeStatus}" FontSize="12" Opacity="0.8" TextWrapping="Wrap"
                               IsVisible="{Binding WipeStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
