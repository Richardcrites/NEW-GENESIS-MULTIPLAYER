<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pulsar.ViewModels"
             mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="620"
             x:Class="Pulsar.Views.KeybindsView"
             x:DataType="vm:KeybindsViewModel"
             Focusable="True">

    <Design.DataContext>
        <vm:KeybindsViewModel />
    </Design.DataContext>

    <ScrollViewer Padding="32,28">
        <StackPanel Spacing="0" MaxWidth="620" HorizontalAlignment="Left">

            <TextBlock Classes="PageTitle" Text="Keybinds" />
            <TextBlock Classes="PageSubtitle"
                       Text="Remap the in-game hotkeys. Changes are written to PULSAR.ini and apply on the next game start." />

            <!-- Player bindings -->
            <Border Classes="Card" Margin="0,0,0,16">
                <StackPanel Spacing="12">
                    <TextBlock Classes="SectionHeader" Text="Player hotkeys" />

                    <ItemsControl ItemsSource="{Binding Bindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:KeybindRowViewModel">
                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="6"
                                            Padding="12,5" MinWidth="84"
                                            VerticalAlignment="Center" Margin="12,0,8,0">
                                        <TextBlock Text="{Binding KeyName}"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="Consolas,monospace"
                                                   FontWeight="SemiBold" />
                                    </Border>

                                    <Button Grid.Column="2"
                                            VerticalAlignment="Center"
                                            MinWidth="120"
                                            Content="{Binding ButtonText}"
                                            Classes.accent="{Binding IsCapturing}"
                                            Command="{Binding $parent[ItemsControl].((vm:KeybindsViewModel)DataContext).StartCaptureCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding CaptureNote}"
                               IsVisible="{Binding CaptureNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="12"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock Text="Press a key while rebinding. Esc cancels. Supported: F1-F24, A-Z, 0-9, Numpad0-9."
                               FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Developer hotkeys -->
            <Border Classes="Card" Margin="0,0,0,16">
                <StackPanel Spacing="8">
                    <TextBlock Classes="SectionHeader" Text="Developer hotkeys" />
                    <ToggleSwitch Content="Enable developer hotkeys"
                                  IsChecked="{Binding DevHotkeys}" />
                    <TextBlock Text="Enables diagnostic hotkeys (flashlight dump, save-format probes, debug revive). Leave off for normal play."
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Save + status -->
            <Border Classes="Card">
                <StackPanel Spacing="10">
                    <Button Content="Save to PULSAR.ini"
                            Classes="accent"
                            HorizontalAlignment="Left"
                            IsEnabled="{Binding CanSave}"
                            Command="{Binding SaveCommand}" />
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
