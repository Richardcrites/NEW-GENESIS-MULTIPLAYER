<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:local="using:Pulsar"
             x:Class="Pulsar.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <!-- FluentAvalonia provides the Fluent (WinUI) look; theme variant is
             forced Dark on the Application above so the whole app is dark. -->
        <sty:FluentAvaloniaTheme PreferSystemTheme="False" />
        <StyleInclude Source="avares://Pulsar/Styles/AppStyles.axaml" />
    </Application.Styles>

</Application>
