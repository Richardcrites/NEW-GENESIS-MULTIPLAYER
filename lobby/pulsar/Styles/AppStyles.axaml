<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared visual language for PULSAR: spacing, headers, status pill, and the
         left nav buttons. Keeps the pages clean and consistent. -->

    <Style Selector="TextBlock.PageTitle">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style Selector="TextBlock.PageSubtitle">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="Margin" Value="0,0,0,18" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.SectionHeader">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.85" />
        <Setter Property="Margin" Value="0,6,0,6" />
    </Style>

    <Style Selector="TextBlock.FieldLabel">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="Margin" Value="2,0,0,4" />
    </Style>

    <!-- Card surface used to group related controls. -->
    <Style Selector="Border.Card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <!-- Connection status pill (green when connected, red when not). -->
    <Style Selector="Border.StatusPill">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.StatusPill.Connected">
        <Setter Property="Background" Value="#2E7D32" />
    </Style>
    <Style Selector="Border.StatusPill.Disconnected">
        <Setter Property="Background" Value="#B23A3A" />
    </Style>
    <Style Selector="Border.StatusPill TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Big primary action button on the Play page. -->
    <Style Selector="Button.Primary">
        <Setter Property="Height" Value="44" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- Left navigation buttons (hand-built nav fallback). -->
    <Style Selector="ListBox.NavList">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="ListBox.NavList ListBoxItem">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FontSize" Value="14" />
    </Style>

</Styles>
